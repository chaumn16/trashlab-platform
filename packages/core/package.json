{
  "name": "@trashlab/core",
  "version": "4.3.0",
  "description": "TrashLab core platform. Pickup scheduling, job management, invoicing. Consumed as a versioned package by every tenant app.",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./extend": "./dist/extend/index.js",
    "./app": "./dist/app/index.js",
    "./conformance": "./dist/conformance/index.js",
    "./db": "./dist/db/postgres.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack": "npm run build && npm pack --pack-destination ../../dist-releases"
  },
  "peerDependencies": {
    "react": ">=19",
    "next": ">=15",
    "pg": ">=8"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/react": "^19.0.0",
    "@types/node": "^22.0.0",
    "next": "^15.0.0",
    "react": "^19.0.0"
  },
  "bin": {
    "trashlab-core": "./bin/trashlab-core.mjs"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  }
}
