# Copy to .env.local for local development, and set the same values as
# Environment Variables on the Vercel project for production.

# Bearer token that tenant CI and deploy workflows present when reporting status,
# and that the /api/tenants endpoints require.
# Must match the CONTROL_PLANE_TOKEN secret in every tenant repo.
# Generate with: openssl rand -hex 32
CONTROL_PLANE_TOKEN=

# Lets the Add-tenant form start the provisioning workflow.
# A fine-grained PAT with "Contents: read and write" on the platform repo only —
# this token triggers a workflow, it does NOT provision. VERCEL_TOKEN and the
# fleet GitHub token live in GitHub Actions secrets, never here.
# Leave unset locally: requests are recorded and shown, but nothing is dispatched.
GITHUB_DISPATCH_TOKEN=

# Repo whose provision-tenant workflow the form triggers.
PLATFORM_REPO=chaumn16/trashlab-platform

# Once the registry moves off the bundled JSON (see lib/registry.ts swap point):
# DATABASE_URL=
